generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  mrp         Float
  category    String
  imageUrl    String
  brandColor  String
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  posts       ScheduledPost[]
  listings    EcomListing[]
}

model ScheduledPost {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  posterUrl   String
  caption     String
  platforms   String
  scheduledAt DateTime
  status      String    @default("pending")
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
}

model CustomPlatform {
  id        String   @id @default(cuid())
  kind      String   // "social" | "ecom"
  slug      String   @unique
  label     String
  apiKey    String?
  createdAt DateTime @default(now())
}

model EcomListing {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform   String
  status     String   @default("pending")
  platformId String?
  error      String?
  createdAt  DateTime @default(now())
}
